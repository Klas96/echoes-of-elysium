"side","type":"string","value":"south"}]},{"id":15,"name":"checkpoint","type":"","rotation":0,"visible":true,"x":304.0,"y":192.0,"width":32.0,"height":32.0,"properties":[{"name":"label","type":"string","value":"Crash Site"}]},{"id":16,"name":"checkpoint","type":"","rotation":0,"visible":true,"x":416.0,"y":544.0,"width":32.0,"height":32.0,"properties":[{"name":"label","type":"string","value":"Crossroads"}]},{"id":17,"name":"checkpoint","type":"","rotation":0,"visible":true,"x":544.0,"y":992.0,"width":32.0,"height":32.0,"properties":[{"name":"label","type":"string","value":"Asha's Trail"}]},{"id":18,"name":"checkpoint","type":"","rotation":0,"visible":true,"x":544.0,"y":1616.0,"width":32.0,"height":32.0,"properties":[{"name":"label","type":"string","value":"South Road"}]},{"id":19,"name":"examine","type":"","rotation":0,"visible":true,"x":368.0,"y":179.0,"width":20.0,"height":20.0,"properties":[{"name":"id","type":"string","value":"woods_plaque"},{"name":"title","type":"string","value":"WEATHERED PLAQUE"},{"name":"text","type":"string","value":"\"We asked to stay.\" A second line: \"Bodies to soil. Minds to Gaia.\""},{"name":"clue","type":"string","value":"gaia_plaque"}]},{"id":20,"name":"examine","type":"","rotation":0,"visible":true,"x":272.0,"y":243.0,"width":20.0,"height":20.0,"properties":[{"name":"id","type":"string","value":"woods_mission_slate"},{"name":"title","type":"string","value":"FIELD BRIEF"},{"name":"text","type":"string","value":"Kaela \u2014 talk to Gaia (green) by the crash. Collect two glowing fragments. Walk south to the City. Do not let the UEC wipe her."}]},{"id":21,"name":"examine","type":"","rotation":0,"visible":true,"x":457.0,"y":992.0,"width":20.0,"height":20.0,"properties":[{"name":"id","type":"string","value":"woods_boot"},{"name":"title","type":"string","value":"UEC BOOT PRINT"},{"name":"text","type":"string","value":"Fresh composite sole marks in the moss after rain."},{"name":"clue","type":"string","value":"boot_print"}]},{"id":22,"nam