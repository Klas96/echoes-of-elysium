      },
      {
       "name": "title",
       "type": "string",
       "value": "DIAGNOSTIC SKIFF"
      },
      {
       "name": "text",
       "type": "string",
       "value": "Hull still warm. Flight log ends mid-sentence: ORBITAL PASS \u00b7 GAIA DIAG \u00b7 CHANNEL LOCK \u2014 then static. You woke here. Gaia was already waiting in the trees."
      },
      {
       "name": "clue",
       "type": "string",
       "value": "skiff_crash"
      }
     ]
    },
    {
     "id": 17,
