0,"visible":true,"x":337.0,"y":241.0,"width":30.0,"height":30.0,"properties":[{"name":"name","type":"string","value":"gaia"}]},{"id":3,"name":"npc","type":"","rotation":0,"visible":true,"x":753.0,"y":1041.0,"width":30.0,"height":30.0,"properties":[{"name":"name","type":"string","value":"asha"}]},{"id":4,"name":"fragment","type":"","rotation":0,"visible":true,"x":1191.0,"y":391.0,"width":18.0,"height":18.0,"properties":[{"name":"pid","type":"string","value":"615_519"}]},{"id":5,"name":"fragment","type":"","rotation":0,"visible":true,"x":1607.0,"y":743.0,"width":18.0,"height":18.0,"properties":[{"name":"pid","type":"string","value":"759_1223"}]},{"id":6,"name":"health","type":"","rotation":0,"visible":true,"x":536.0,"y":376.0,"width":16.0,"height":16.0,"properties":[{"name":"pid","type":"string","value":"392_456"}]},{"id":7,"name":"health","type":"","rotation":0,"visible":true,"x":728.0,"y":824.0,"width":16.0,"height":16.0,"properties":[{"name":"pid","type":"string","value":"344_712"}]},{"id":8,"name":"health","type":"","rotation":0,"visible":true,"x":1416.0,"y":968.0,"width":16.0,"height":16.0,"properties":[{"name":"pid","type":"string","value":"632_1064"}]},{"id":9,"name":"drone","type":"","rotation":0,"visible":true,"x":500.0,"y":1060.0,"width":24.0,"height":24.0,"properties":[{"name":"startAngle","type":"float","value":0.0},{"name":"kind","type":"string","value":"scout"}]},{"id":10,"name":"drone","type":"","rotation":0,"visible":true,"x":1076.0,"y":484.0,"width":24.0,"height":24.0,"properties":[{"name":"startAngle","type":"float","value":2.1},{"name":"kind","type":"string","value":"sniper"}]},{"id":11,"name":"drone","type":"","rotation":0,"visible":true,"x":122.0,"y":1220.0,"width":24.0,"height":24.0,"properties":[{"name":"startAngle","type":"float","value":1.2},{"name":"kind","type":"string","value":"scout"},{"name":"nest","type":"bool","value":true}]},{"id":12,"name":"drone","type":"","rotation":0,"visible":true,"x":151.0,"y":1246.0,"width":24.0,"height":24.0,"properties":[{"name":"startAngle","type":"float","value":3.8},{"name":"kind","type":"string","value":"swarm"},{"name":"nest","type":"bool","value":true}]},{"id":13,"name":"mapexit","type":"","rotation":0,"visible":true,"x":1280.0,"y":1344.0,"width":160.0,"height":64.0,"properties":[{"name":"dest","type":"string","value":"city"},{"name":"entry","type":"string","value":"north"},{"name":"lockedTitle","type":"string","value":"WOODS EDGE"},{"name":"lockedBody","type":"string","value":"Two memory fragments open the road south to the City."},{"name":"unlock","type":"string","value":"portal"}]},{"id":14,"name":"entry","type":"","rotation":0,"visible":true,"x":1328.0,"y":1232.0,"width":32.0,"height":32.0,"properties":[{"name":"side","type":"string","value":"south"}]},{"id":15,"name":"checkpoint","type":"","rotation":0,"visible":true,"x":240.0,"y":272.0,"width":32.0,"height":32.0,"properties":[{"name":"label","type":"string","value":"Crash Site"}]},{"id":16,"name":"checkpoint","type":"","rotation":0,"visible":true,"x":832.0,"y":736.0,"width":32.0,"height":32.0,"properties":[{"name":"label","type":"string","value":"Crossroads"}]},{"id":17,"name":"checkpoint","type":"","rotation":0,"visible":true,"x":800.0,"y":1091.0,"width":32.0,"height":32.0,"properties":[{"name":"label","type":"string","value":"Asha's Camp"}]},{"id":18,"name":"checkpoint","type":"","rotation":0,"visible":true,"x":1248.0,"y":1104.0,"width":32.0,"height":32.0,"properties":[{"name":"label","type":"string","value":"South Meadow"}]},{"id":19,"name":"examine","type":"","rotation":0,"visible":true,"x":304.0,"y":259.0,"width":20.0,"height":20.0,"properties":[{"name":"id","type":"string","value":"woods_plaque"},{"name":"title","type":"string","value":"WEATHERED PLAQUE"},{"name":"text","type":"string","value":"\"We asked to stay.\" A second line: \"Bodies to soil. Minds to Gaia.\""},{"name":"clue","type":"string","value":"gaia_plaque"}]},{"id":20,"name":"examine","type":"","rotation":0,"visible":true,"x":208.0,"y":323.0,"width":20.0,"height":20.0,"properties":[{"name":"id","type":"string","value":"woods_mission_slate"},{"name":"title","type":"string","value":"FIELD BRIEF"},{"name":"text","type":"string","value":"Kaela \u2014 talk to Gaia (green) by the crash. Collect any two glowing fragments; the trails ring round, so every clearing has two ways in. The road to the City leaves the south-east meadow. Do not let the UEC wipe her."}]},{"id":21,"name":"examine","type":"","rotation":0,"visible":true,"x":713.0,"y":1072.0,"width":20.0,"height":20.0,"properties":[{"name":"id","type":"string","value":"woods_boot"},{"name":"title","type":"string","value":"UEC BOOT PRINT"},{"name":"text","type":"string","value":"Fresh composite sole marks in the moss after rain."},{"name":"clue","type":"string","value":"boot_print"}]},{"id":22,"name":"examine","type":"","rotation":0,"visible":true,"x":185.0,"y":668.0,"width":20.0,"height":20.0,"properties":[{"name":"id","type":"string","value":"woods_courier_pack"},{"name":"title","type":"string","value":"SEALED COURIER PACK"},{"name":"text","type":"string","value":"Lantern Town wax seal. Someone meant this for Mira's board."},{"name":"quest","type":"string","value":"courier_pack"}]},{"id":23,"name":"stash","type":"","rotation":0,"visible":true,"x":141.0,"y":704.0,"width":32.0,"height":32.0,"properties":[{"name":"glimmer","type":"int","value":12},{"name":"pid","type":"string","value":"166_336"}]},{"id":24,"name":"examine","type":"","rotation":0,"visible":true,"x":185.0,"y":1225.0,"width":20.0,"height":20.0,"properties":[{"name":"id","type":"string","value":"woods_nest_slate"},{"name":"title","type":"string","value":"UEC FIELD SLATE"},{"name":"text","type":"string","value":"Nest roster. Two units. 'Hold the west loop until recall.'"},{"name":"clue","type":"string","value":"quest_nest_slate"}]},{"id":25,"name":"examine","type":"","rotation":0,"visible":true,"x":486.0,"y":1142.0,"width":20.0,"height":20.0,"properties":[{"name":"id","type":"string","value":"woods_moonflower_pick"},{"name":"title","type":"string","value":"MOONFLOWER CLUSTER"},{"name":"text","type":"string","value":"A bloom cold as glass. Mira asked for one of these."},{"name":"give","type":"string","value":"moonflower_bloom"},{"name":"quest","type":"string","value":"moonflower_draft"}]},{"id":26,"name":"examine","type":"","rotation":0,"visible":true,"x":892.0,"y":707.0,"width":20.0,"height":20.0,"properties":[{"name":"id","type":"string","value":"woods_fork_sign"},{"name":"title","type":"string","value":"STANDING STONES"},{"name":"text","type":"string","value":"Every trail meets here. NE: the pond. E: the grove. S: Asha's camp. W: the mossy hollow and round to the crash. Fragments glow out there; any two open the City road from the south-east meadow."}]},{"id":27,"name":"examine","type":"","rotation":0,"visible":true,"x":1030.0,"y":166.0,"width":20.0,"height":20.0,"properties":[{"name":"id","type":"string","value":"woods_ridge_lookout"},{"name":"title","type":"string","value":"CITY LIGHTS TO THE SOUTH"},{"name":"text","type":"string","value":"From the ridge, past the radio dish, the City's glow hangs over the treeline to the south-east. The trails below all ring round to the meadow road."}]},{"id":28,"name":"examine","type":"","rotation":0,"visible":true,"x":771.0,"y":835.0,"width":20.0,"height":20.0,"properties":[{"name":"id","type":"string","value":"woods_job_sign"},{"name":"title","type":"string","value":"TRAIL NOTICE"},{"name":"text","type":"string","value":"Chalk: once you reach the City, look EAST down the boulevard for Lantern Town \u2014 jobs and glimmer."}]},{"id":29,"name":"examine","type":"","rotation":0,"visible":true,"x":1145.0,"y":409.0,"width":20.0,"height":20.0,"properties":[{"name":"id","type":"string","value":"woods_glade_sign"},{"name":"title","type":"string","value":"SIDE PATH MARK"},{"name":"text","type":"string","value":"Trails leave the pond three ways: west along the ridge, south-west to the stones, south to the grove. You will not